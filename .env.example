# Yosemite AI — Local Environment Configuration (Placeholders Only)
# Copy to an ignored local .env file. Never commit real credentials or expose
# server secrets (such as service-role keys, session secrets, or database URLs) in frontend code.

APP_ENV=development
APP_ORIGIN=http://localhost:3000
TRUSTED_PROXY_MODE=platform

# Safety invariants (must remain disabled)
TRADING_MODE=disabled
LIVE_TRADING_ENABLED=false
WORKER_ENABLED=false
MT5_EXECUTION_ENABLED=false
MT5_DEMO_MODE=false
MT5_CONNECTOR=none

# Supabase Auth (server-side Email + Password; single owner restricted via UUID)
# Use the anonymous/publishable key only — NEVER configure SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_replace_with_supabase_anon_key
SUPABASE_OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# Session & Supabase PostgreSQL persistence (server-only; never expose in browser code)
# Runtime requests: Supabase Supavisor Transaction Mode (:6543)
# DDL migrations:   Supabase Supavisor Session Mode (:5432, IPv4-compatible) or Direct (:5432, IPv6)
SESSION_SECRET=replace-with-at-least-32-random-bytes-for-local-dev
DATABASE_URL=postgresql://postgres.your-project-ref:replace-with-db-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.your-project-ref:replace-with-db-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL_UNPOOLED=

# Optional read-only / advisory providers (disabled by default)
MARKET_DATA_PROVIDER=none
TWELVE_DATA_API_KEY=
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
NEWS_PROVIDER=none
NEWS_API_KEY=
