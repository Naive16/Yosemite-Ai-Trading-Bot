# Yosemite AI Trading Bot - Local Environment Configuration
#
# Copy this file to .env (gitignored, never committed) and fill in values.
# Platform environment values take precedence over .env.
#
# Never commit real keys or secrets. Do not add SUPABASE_SERVICE_ROLE_KEY here
# unless you intend to run the Cloudflare Access path locally; it must never
# reach browser code.

# Application environment: development | test | production
APP_ENV=development

# Public origin of the running server (required as HTTPS in production)
APP_ORIGIN=http://localhost:3000

# --- Supabase (required for authentication and database access) ---
# Public URL of the Supabase project. Defaults to the Yosemite project in
# development; must match txdjozotaxpthpnfikqx in production.
SUPABASE_URL=https://txdjozotaxpthpnfikqx.supabase.co

# Public publishable (anon) key. Required. Obtain from the Supabase project
# dashboard under Settings > API > Project API keys > public anon key.
# Never use a service-role or secret key here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Cloudflare Access (dashboard edge authentication; server-side only) ---
# Required for the no-login-page dashboard flow. Cloudflare Access verifies
# the user at the edge; the Worker validates the Cf-Access-Jwt-Assertion JWT.
# Obtain the JWKS URL from your Cloudflare Access application configuration.
CLOUDFLARE_ACCESS_JWKS_URL=https://<your-team>.cloudflareaccess.com/.well-known/jwks

# Optional audience claim expected in Cloudflare Access assertions.
CLOUDFLARE_ACCESS_AUDIENCE=yosemite-dashboard

# --- Supabase service-role key (server-side only, Cloudflare Access path) ---
# Required only when using Cloudflare Access for dashboard auth. Enables the
# Worker's server-side Data API client. Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Safety switches (must remain disabled) ---
TRADING_MODE=disabled
LIVE_TRADING_ENABLED=false
WORKER_ENABLED=false
MT5_EXECUTION_ENABLED=false
