{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yosemite-ai-trading-bot",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "APP_ENV": "production",
    "APP_ORIGIN": "https://yosemite-ai-trading-bot.francismkanda01.workers.dev",
    "SUPABASE_URL": "https://txdjozotaxpthpnfikqx.supabase.co",
    "TRADING_MODE": "disabled",
    "LIVE_TRADING_ENABLED": "false",
    "WORKER_ENABLED": "false",
    "MT5_EXECUTION_ENABLED": "false",
    "MT5_DEMO_MODE": "false",
    "MT5_CONNECTOR": "none"
  },
  "dev": { "port": 8787 },
  "assets": {
    "directory": "src",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  "observability": { "enabled": true, "redact_query_string": true, "traces": { "enabled": true } }
}
